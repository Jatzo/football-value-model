# Where downloaded CSV files are cached.
VALUEMODEL_DATA_DIR=data

# Seconds to wait between downloads so the data source is not hammered.
VALUEMODEL_REQUEST_DELAY=2

# How the bookmaker's margin is removed from odds: power or proportional.
VALUEMODEL_MARGIN_METHOD=power

# A bet has value when model probability times odds, minus 1, is at least this.
VALUEMODEL_EDGE_THRESHOLD=0.03

# Paper staking: kelly or flat.
VALUEMODEL_STAKING=kelly

# Share of the full Kelly stake to use.
VALUEMODEL_KELLY_FRACTION=0.25

# Largest stake on one bet, as a share of the current bankroll.
VALUEMODEL_MAX_STAKE=0.02

# Flat stake, as a share of the starting bankroll.
VALUEMODEL_FLAT_STAKE=0.01

# Starting bankroll in units.
VALUEMODEL_STARTING_BANKROLL=1000

# Bookmaker whose pre-match prices paper bets are taken at: b365 or pinnacle.
VALUEMODEL_BOOKMAKER=b365
